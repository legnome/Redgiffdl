<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Téléchargements en service de premier plan : continuent écran verrouillé -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 8/9 uniquement : sert seulement à rapatrier les anciens fichiers de Téléchargements/RedGIFs
         (déjà accordée si tu avais utilisé une version précédente ; jamais redemandée). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- allowBackup=false : la bibliothèque privée n'est pas envoyée dans la sauvegarde Google. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Menu "Partager" (un lien texte) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Ouvrir avec" sur un lien redgifs.com -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="redgifs.com" />
                <data android:host="www.redgifs.com" />
                <data android:host="v3.redgifs.com" />
                <data android:pathPrefix="/watch/" />
                <data android:pathPrefix="/ifr/" />
                <data android:pathPattern="/users/.*/collections/.*" />
            </intent-filter>
        </activity>

        <!-- Menu Partager > "Télécharger (redDL)" : téléchargement en arrière-plan sans ouvrir l'appli.
             Désactivable depuis l'écran principal (PackageManager.setComponentEnabledSetting). -->
        <activity
            android:name=".ShareDownloadActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/share_download_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/ShareTheme">
            <intent-filter android:label="@string/share_download_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LibraryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/PlayerTheme" />
    </application>
</manifest>
